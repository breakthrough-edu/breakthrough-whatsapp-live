<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  intake-evening.plist · LaunchAgent template for the evening intake push, rendered by wa_setup.py.
  Placeholders: {LABEL} launchd.intake_label · {NODE} the node binary that has Full Disk Access · {SCRIPT} the installed
  copy of templates/intake-evening.mjs · {HOME_DIR} the owner's home folder · {HOUR} {MINUTE} from intake.evening_at ·
  {LOG} the log file (stdout and stderr).
  One run a day, never at load, never kept alive. Install it only while intake.enabled and intake.evening_push are true;
  the script itself also exits with one log line when they are false.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{NODE}</string>
    <string>{SCRIPT}</string>
  </array>
  <key>WorkingDirectory</key><string>{HOME_DIR}</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>{HOUR}</integer>
    <key>Minute</key><integer>{MINUTE}</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{LOG}</string>
  <key>StandardErrorPath</key><string>{LOG}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{HOME_DIR}</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
